# =====================================================================
# 摸薪 Mocent — .gitignore
#
# 组织方式：先按「本项目实际会产生的文件」分类，再保留 Node/前端通用规则。
# 规则从上到下逐条检查，`!` 开头的为反向例外（重新纳入跟踪）。
# =====================================================================

# ---------------------------------------------------------------------
# 本机构建工具链（体积大、可复现下载，绝不入库）
# ---------------------------------------------------------------------
# WiX Toolset（编译 MSI 用）：wix314-binaries.zip 解压而来，约 40MB
.tools/
# 构建产物总目录：MSI / 便携版 zip / 组装出的运行文件
dist/

# ---------------------------------------------------------------------
# 临时调试目录（排查问题时的一次性产物）
# ---------------------------------------------------------------------
.probe/
.tmp/
tmp/

# ---------------------------------------------------------------------
# AI 助手工作目录（会话记忆、任务状态，属于个人工作痕迹）
# ---------------------------------------------------------------------
.workbuddy/

# ---------------------------------------------------------------------
# 桌面端（C# / .NET Framework + WebView2）
# ---------------------------------------------------------------------
desktop/bin/
desktop/obj/
# csc 直编模式不产生这些，但 dotnet SDK 备用编译路径会产生
desktop/**/bin/
desktop/**/obj/

# ---------------------------------------------------------------------
# Android（Gradle / AGP）
# ---------------------------------------------------------------------
android/.gradle/
android/build/
android/app/build/
# 本机 SDK 路径与签名信息（含密码，必须忽略）
android/local.properties
android/keystore.properties
android/*.keystore
android/*.jks
# 打包产物
*.apk
*.aab
*.ap_
# Gradle 守护进程与构建缓存
.gradle/
# 原生调试符号
*.hprof

# ---------------------------------------------------------------------
# 操作系统 / 编辑器垃圾
# ---------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
nohup.out
# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*#
*.orig
*.rej

# ---------------------------------------------------------------------
# 日志与运行时数据
# ---------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 应用运行期写入的数据（%LOCALAPPDATA%\Mocent\ 不在这里，但防止误放进仓库时被提交）
window.json
mini.json
crash.log
wnd.log

# 诊断报告（https://nodejs.org/api/report.html）
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 进程 / 运行时数据
pids
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------
# 密钥 / 环境变量（绝不入库）
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------
# Node / 前端通用
# ---------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
bower_components

# 测试覆盖率
coverage
*.lcov
.nyc_output
lib-cov

# TypeScript / Lint 缓存
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity

# 各类打包器 / 框架缓存与产物
.cache
.parcel-cache
.parcel-cache/
.grunt
.lock-wscript
build/Release
.next
out
.nuxt
.output
.svelte-kit/
.temp
.turbo
.vercel
**.vitepress/dist
**.vitepress/cache
.vuepress/dist
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test

# pnpm / yarn v3
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ---------------------------------------------------------------------
# 本项目的内部文档（含本机绝对路径与内部决策记录，不入公开仓库）
# ---------------------------------------------------------------------
# 注：如需把交接文档一并公开，删掉下面这行即可（文件已在仓库根目录）
HANDOFF.md


# ---------------------------------------------------------------------
# 明确「不」忽略（这些是构建资产，必须入库）
# ---------------------------------------------------------------------
# 说明：以下文件刻意保持在跟踪范围，写在这里当文档用，不需要 `!` 规则。
#   desktop/build.sh          桌面端构建脚本
#   desktop/dump-msi-tables.ps1  MSI 内容校验脚本
#   desktop/app.manifest      应用清单（DPI 感知等）
#   android/build.sh          Android 构建脚本
#   desktop/Mocent.csproj     备用 dotnet 编译路径（build.sh 不可用时的语法校验）
#   web/regions.json          省市社保/公积金基准数据
#   docs/*.md                 设计与调研文档
